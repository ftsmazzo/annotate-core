{
  "name": "annotate-core",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter widget build && pnpm --filter dashboard build && pnpm --filter server build",
    "dev:server": "pnpm --filter server dev",
    "dev:dashboard": "pnpm --filter dashboard dev",
    "db:generate": "pnpm --filter server db:generate",
    "db:migrate": "pnpm --filter server db:migrate"
  }
}
