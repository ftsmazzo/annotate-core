# Postgres dedicado deste serviço (nunca reaproveitar o banco de outro projeto no infra-core)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/annotate_dev

# Porta HTTP do servidor (server + dashboard + MCP + widget estático)
PORT=3000

# Base URL pública onde este serviço fica acessível (usada em links do dashboard e no widget)
APP_BASE_URL=http://localhost:3000

NODE_ENV=development

# GlitchTip (self-hosted, protocolo Sentry) — opcional. Sem isso, observabilidade é um no-op.
# Gerar em: GlitchTip -> Organization -> Project -> copiar o DSN.
SENTRY_DSN=

# Protege POST /api/v1/admin/projects (bootstrap de projeto em produção, sem shell no container).
# Sem essa env, a rota sempre responde 401 — gere um valor aleatório antes do primeiro deploy real.
ADMIN_TOKEN=
